# =============================================================================
# DNA FINANCEIRO — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — obrigatórias
# Supabase Dashboard → Settings → API
# ---------------------------------------------------------------------------

# URL do projeto (pública — pode ir no client)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave anônima (pública — client-side, respeita RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (PRIVADA — nunca exposta ao browser)
# Usada pelo servidor para inserir leads com unit_id injetado
# Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# App — opcionais mas recomendadas
# ---------------------------------------------------------------------------

# URL base da aplicação (usada para montar source_url no servidor)
NEXT_PUBLIC_APP_URL=http://localhost:3000
