# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Dashboard → Settings → API

# Pública — usada no client e no servidor
NEXT_PUBLIC_SUPABASE_URL=

# Pública — respeita RLS, segura para o browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PRIVADA — nunca expor ao browser, sem prefixo NEXT_PUBLIC_
# Usada apenas no servidor para inserir leads com unit_id
SUPABASE_SERVICE_ROLE_KEY=
